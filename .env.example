# jev-router configuration. Copy to .env and fill in, or just export these.
# Every value below is the code's own default, so an empty .env behaves the
# same as no .env. Only TYPESAFE_API_KEY has no usable default.
#
# .env is gitignored. Do not commit a real key.

# ---------------------------------------------------------------------------
# Jev (the judge). Without a key the router forwards everything untouched.
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# ---------------------------------------------------------------------------
# Upstream. Anthropic credential is NOT needed if Claude Code sends its own,
# which it always does. It is injected only when the client sends none.
# ---------------------------------------------------------------------------
ROUTER_UPSTREAM=https://api.anthropic.com
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# The ladder. Cheapest first. The index into this list is the "tier".
# Keep it to models your plan or key actually serves: behind a gateway
# Claude Code stops checking, so a model you cannot use fails upstream.
# ---------------------------------------------------------------------------
ROUTER_TIERS=["claude-haiku-4-5", "claude-sonnet-5", "claude-opus-5"]

# ---------------------------------------------------------------------------
# Routing policy
# ---------------------------------------------------------------------------
# Below this confidence, Jev's answer is not trusted and the tool-derived
# phase hint is used instead.
ROUTER_MIN_CONFIDENCE=0.45
# 1 or 0. Also flippable at runtime via POST /router/toggle.
ROUTER_ENABLED=1
# Only route requests whose model field equals this. "" routes everything.
# Set it to keep /model working as a manual override. See DEVELOPER.md.
ROUTER_SENTINEL=
# Fallback recheck cadence in turns. Rechecks are event-driven; this only
# fires when no event does. 0 disables the cadence, events still fire.
ROUTER_RECHECK_EVERY=6
# Regex for "this is a risk surface". Override to match your own repo.
# ROUTER_RISK_SURFACE=
# Seconds before a Jev call is abandoned and the turn forwards unrouted.
ROUTER_CLASSIFY_TIMEOUT=2.0

# ---------------------------------------------------------------------------
# Cache economics. This is what decides whether routing saves money.
# VERIFY PRICES against current list prices before trusting the arithmetic.
# ---------------------------------------------------------------------------
ROUTER_PRICES={"claude-haiku-4-5":{"in":1.0,"out":5.0},"claude-sonnet-5":{"in":3.0,"out":15.0},"claude-opus-5":{"in":5.0,"out":25.0}}
# Cache write bills at 1.25x base input, cache read at 0.10x.
ROUTER_CACHE_WRITE_MULT=1.25
ROUTER_CACHE_HIT_MULT=0.10
# Treat the cache as cold after this many seconds. Under the real 5 min TTL
# on purpose, because the TTL runs from the START of the touching request.
ROUTER_CACHE_TTL_SAFE=240
# Turns over which a one-time cache rebuild must pay for itself.
ROUTER_SWITCH_HORIZON=3
# Priors for per-model output volume, used until enough turns are observed.
ROUTER_VERBOSITY={}
# Priors for per-model agentic turn count. A cheaper model that needs more
# turns is not cheaper.
ROUTER_TURN_MULT={}
# Turns of real usage needed per model before the learned output ratio is
# trusted over the prior.
ROUTER_OUT_RATE_MIN_SAMPLES=8
# Fallback only, used before any usage telemetry has been seen.
ROUTER_DOWNGRADE_PATIENCE=3
# Jev input price, $/MTok. Its output is treated as free.
ROUTER_JEV_PRICE_IN=0.042

# ---------------------------------------------------------------------------
# Effort steering. The cheap lever: it changes effort on the SAME model, so
# the prompt cache survives. Off by default because it is beta, and it is the
# only place this proxy edits `messages`.
# ---------------------------------------------------------------------------
ROUTER_EFFORT_STEERING=0
ROUTER_EFFORT_CAPABLE=["claude-opus-5", "claude-fable-5-1", "claude-mythos-5-1"]
ROUTER_EFFORT_BETA=mid-conversation-output-config-2026-07-01

# ---------------------------------------------------------------------------
# Utility pin. Claude Code interleaves tiny sidecar calls (permission
# classifiers, quota probes) into the session. They are not turns. Requests
# at or below this max_tokens are pinned and kept out of routing state.
# ---------------------------------------------------------------------------
ROUTER_UTILITY_MAX_TOKENS=1024
# Defaults to the middle rung of ROUTER_TIERS.
# ROUTER_UTILITY_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ROUTER_LOG_LEVEL=INFO
# Off by default. Traces contain short previews of your prompts. Point this
# OUTSIDE the source tree. *.jsonl is gitignored for exactly this reason.
ROUTER_TRACE_DIR=
